# clickup-tracker (standalone) — copy to .env and fill in.
#
# ── ClickUp credentials ────────────────────────────────────────────────────
# Two paths to provide credentials to the daemon. Pick ONE.
#
# Path A — Personal API Token (simplest for solo use):
#   ClickUp → Personal Settings → Apps → Generate.
#   Token format: "pk_..."
#   Drop the value in CLICKUP_API_TOKEN below.
#
# Path B — OAuth App (use when your account doesn't allow personal tokens,
#   or you want one-token-per-team scoping):
#   1. Create an OAuth app at https://app.clickup.com/settings/apps with:
#        Redirect URL: http://localhost:8765
#   2. Fill CLICKUP_CLIENT_ID + CLICKUP_CLIENT_SECRET below.
#   3. Run: bash scripts/oauth-bootstrap.sh
#      (writes CLICKUP_API_TOKEN + CLICKUP_TEAM_ID into this file for you)
#
# After either path, the daemon authenticates with CLICKUP_API_TOKEN.

CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_TEAM_ID=12345678
CLICKUP_TEAM_NAME=My Workspace

# Path B (OAuth) — only needed if you're using oauth-bootstrap.sh.
# Leave blank for Path A.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:8765

# Optional knobs ------------------------------------------------------------

# Where the daemon listens on the host. Change if 4020 is already taken.
TRACKER_PORT=4020

# Postgres / Redis container ports (host-side). Default to standard ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=cup
POSTGRES_PASSWORD=cup
POSTGRES_DB=clickup_tracker

# ClickUp client tuning
CLICKUP_API_BASE=https://api.clickup.com/api/v2
CLICKUP_RATE_LIMIT=90
DEFAULT_CLICKUP_SPACE_NAME=Default

# Drift cron sweep interval (minutes). Default 60. Drop to 5 in dev to
# exercise the path quickly.
CUP_TRACKER_DRIFT_MINUTES=60

# Optional bearer token for internal routes (PUT/POST/DELETE /projects).
# Unset = open (fine for localhost-only). Set if you expose the port.
STANDALONE_API_TOKEN=

# Optional bearer token for /public/metrics. Unset = open.
METRICS_AUTH_TOKEN=

# pino log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
