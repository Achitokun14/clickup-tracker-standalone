# clickup-tracker (standalone) — copy to .env and fill in.
#
# Required: a ClickUp API token (Personal Settings → Apps → API Token,
# starts with "pk_") and your team/workspace ID (the integer in
# https://app.clickup.com/<TEAM_ID>/...).

CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_TEAM_ID=12345678
CLICKUP_TEAM_NAME=My Workspace

# Optional knobs ------------------------------------------------------------

# Where the daemon listens on the host. Change if 4020 is already taken.
TRACKER_PORT=4020

# Postgres / Redis container ports (host-side). Default to standard ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=cup
POSTGRES_PASSWORD=cup
POSTGRES_DB=clickup_tracker

# ClickUp client tuning
CLICKUP_API_BASE=https://api.clickup.com/api/v2
CLICKUP_RATE_LIMIT=90
DEFAULT_CLICKUP_SPACE_NAME=Default

# Drift cron sweep interval (minutes). Default 60. Drop to 5 in dev to
# exercise the path quickly.
CUP_TRACKER_DRIFT_MINUTES=60

# Optional bearer token for internal routes (PUT/POST/DELETE /projects).
# Unset = open (fine for localhost-only). Set if you expose the port.
STANDALONE_API_TOKEN=

# Optional bearer token for /public/metrics. Unset = open.
METRICS_AUTH_TOKEN=

# pino log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
